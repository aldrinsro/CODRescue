# Example .env for chatbot/n8n
# n8n (ngrok) public URL and editor
EDITOR_BASE_URL=https://jax-cressier-nondevoutly.ngrok-free.dev
WEBHOOK_URL=https://jax-cressier-nondevoutly.ngrok-free.dev
# basic auth for n8n UI
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Django application database (example values you provided)
DB_TYPE=yzrescue_db
DB_POSTGRESDB_HOST=host.docker.internal
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=admin
DB_POSTGRESDB_DATABASE=admin

# If you want to override the chatbot webhook path in Django settings
# N8N_CHATBOT_WEBHOOK=chatbot
# N8N_WEBHOOK_BASE=https://jax-cressier-nondevoutly.ngrok-free.dev
